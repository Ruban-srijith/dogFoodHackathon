# Dogfood Platform - Environment Configuration

# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dogfood
DB_USER=dogfood_user
DB_PASSWORD=dogfood_secure_password_2026
DATABASE_URL=postgresql://dogfood_user:dogfood_secure_password_2026@postgres:5432/dogfood

# Direct local database connection for testing/migrations outside docker
# DATABASE_URL=postgresql://dogfood_user:dogfood_secure_password_2026@localhost:5432/dogfood

# Authentication & Security
JWT_SECRET=dogfood_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
SESSION_SECRET=dogfood_session_secret_cookie_vault_key_2026

# Platform Admin Bootstrap (used during initial seed/init if specified)
BOOTSTRAP_ADMIN_EMAIL=admin@dogfood.local
BOOTSTRAP_ADMIN_PASSWORD=DogfoodAdmin123!

# Frontend Configuration
VITE_API_URL=/api/v1
PUBLIC_PORT=8080
